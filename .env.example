# Copy to .env and fill in, used by compose.yml

# Discord bot token, required
ASTERION_TOKEN=

# top.gg API token for publishing server stats, optional (also uncomment it in compose.yml)
# ASTERION_TOP_GG_TOKEN=

# How often to check Modrinth for project updates, in minutes, optional (also uncomment it in compose.yml)
# ASTERION_UPDATE_CHECK_INTERVAL_MINUTES=5

# User and group the bot runs as, ./data is created and owned by them (see `id -u` and `id -g`)
PUID=1000
PGID=1000
