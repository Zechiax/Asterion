<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <DockerDefaultTargetOS>Linux</DockerDefaultTargetOS>
        <IsPackable>false</IsPackable>
        <LangVersion>13</LangVersion>
        <Version>0.0.0-dev</Version>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="ByteSize" Version="2.1.2" />
        <PackageReference Include="Discord.Net" Version="3.20.2" />
        <PackageReference Include="Discord.Net.Core" Version="3.20.2" />
        <PackageReference Include="Fergun.Interactive" Version="1.9.2" />
        <PackageReference Include="Figgle" Version="0.6.6" />
        <PackageReference Include="Figgle.Fonts" Version="0.6.6" />
        <PackageReference Include="Html2Markdown" Version="8.1.2.24" />
        <PackageReference Include="Humanizer.Core" Version="3.0.10" />
        <PackageReference Include="Linguini.Bundle" Version="0.11.0" />
        <PackageReference Include="LiveChartsCore.SkiaSharpView" Version="2.0.5" />
        <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.13" />
        <PackageReference Include="Microsoft.EntityFrameworkCore" Version="10.0.13" />
        <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" Version="10.0.13" />
        <PackageReference Include="Microsoft.EntityFrameworkCore.Tools" Version="10.0.13">
            <PrivateAssets>all</PrivateAssets>
            <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
        </PackageReference>
        <PackageReference Include="Microsoft.Extensions.Configuration" Version="10.0.13" />
        <PackageReference Include="Microsoft.Extensions.Configuration.EnvironmentVariables" Version="10.0.13" />
        <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.13" />
        <PackageReference Include="Microsoft.Extensions.Hosting.Abstractions" Version="10.0.13" />
        <PackageReference Include="Microsoft.Extensions.Http" Version="10.0.13" />
        <PackageReference Include="Microsoft.Extensions.Logging" Version="10.0.13" />
        <PackageReference Include="Microsoft.Extensions.Logging.Console" Version="10.0.13" />
        <PackageReference Include="Microsoft.Extensions.Logging.Debug" Version="10.0.13" />
        <PackageReference Include="Modrinth.Net" Version="3.8.1" />
        <PackageReference Include="Serilog" Version="4.4.0" />
        <PackageReference Include="Serilog.Extensions.Logging" Version="10.0.0" />
        <PackageReference Include="Serilog.Sinks.Console" Version="6.1.1" />
        <PackageReference Include="Serilog.Sinks.File" Version="7.0.0" />
        <PackageReference Include="SkiaSharp.NativeAssets.Linux" Version="4.153.1" />
        <PackageReference Include="System.Data.SQLite" Version="2.0.4" />
        <PackageReference Include="Tomlyn" Version="2.10.1" />
    </ItemGroup>

    <ItemGroup>
      <EmbeddedResource Include="Resources\Locales\**\*.ftl" />
    </ItemGroup>

</Project>
