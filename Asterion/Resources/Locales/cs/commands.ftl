### Názvy a popisy slash příkazů - cs (čeština)
### ID zprávy = "command-" + cesta příkazu spojená pomocí "-".

command-manage =
    .description = Správa odebíraných projektů, sledovaných tvůrců a nastavení serveru

command-follow =
    .description = Sleduj tvůrce na Modrinthu a dostávej zprávy o všech jejich projektech
command-follow-user =
    .description = Sleduj uživatele Modrinthu a dostávej zprávy o všech jeho projektech
command-follow-user-username =
    .description = Uživatelské jméno, ID nebo odkaz na uživatele Modrinthu
command-follow-user-channel =
