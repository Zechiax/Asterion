### Slash command descriptions - en-US (source language)
### Message id = "command-" + the command path joined with "-".
### These are not consumed at runtime for en-US (the [SlashCommand] attribute
### literal is the default); they exist as the source of translation for other locales.
### Only descriptions are translated, command and option names stay in English.

command-manage =
    .description = Manage subscribed projects, followed creators and server settings

command-follow =
    .description = Follow Modrinth creators and get updates for all of their projects
command-follow-user =
    .description = Follow a Modrinth user and get updates for all of their projects
command-follow-user-username =
    .description = Username, ID or link of the Modrinth user
command-follow-user-channel =
    .description = Channel for the messages, this channel if not set
command-follow-user-events =
    .description = Which events to send messages for
command-follow-user-new_project_channel =
    .description = Channel for new project messages, the channel above if not set

command-unfollow =
    .description = Stop following Modrinth creators
command-unfollow-user =
    .description = Stop following a Modrinth user
command-unfollow-user-user =
    .description = Username, ID or link of the followed Modrinth user

command-chart =
    .description = Creates charts of project statistics
command-chart-downloads =
    .description = Charts the downloads of a project
command-chart-downloads-project =
    .description = ID or slug of the project
command-chart-downloads-range =
    .description = Time span of the chart
command-chart-followers =
    .description = Charts the new followers of a project
command-chart-followers-project =
    .description = ID or slug of the project
command-chart-followers-range =
    .description = Time span of the chart
