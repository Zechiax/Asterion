### Slash command names and descriptions - en-US (source language)
### Message id = "command-" + the command path joined with "-".
### These are not consumed at runtime for en-US (the [SlashCommand] attribute
### literal is the default); they exist as the source of translation for other locales.

command-settings =
    .name = settings
    .description = Change settings for Asterion

command-follow =
    .name = follow
    .description = Follow Modrinth creators and get updates for all of their projects
command-follow-user =
    .name = user
    .description = Follow a Modrinth user and get updates for all of their projects
command-follow-user-username =
    .name = username
    .description = Username or ID of the Modrinth user
command-follow-user-channel =
    .name = channel
    .description = Channel for the messages, this channel if not set
command-follow-user-events =
    .name = events
    .description = Which events to send messages for
command-follow-remove =
    .name = remove
    .description = Stop following a creator
command-follow-remove-follow =
    .name = follow
    .description = The followed creator
command-follow-ignore =
    .name = ignore
    .description = Stop sending updates for one project of a followed creator
command-follow-ignore-follow =
    .name = follow
    .description = The followed creator
command-follow-ignore-project =
    .name = project
    .description = The project to ignore
command-follow-unignore =
    .name = unignore
    .description = Send updates again for an ignored project of a followed creator
command-follow-unignore-follow =
    .name = follow
    .description = The followed creator
command-follow-unignore-project =
    .name = project
    .description = The project to stop ignoring
command-follow-settings =
    .name = settings
    .description = Show and change the settings of a followed creator
command-follow-settings-follow =
    .name = follow
    .description = The followed creator
command-follow-settings-channel =
    .name = channel
    .description = New channel for the messages
command-follow-settings-ping_role =
    .name = ping_role
    .description = Role to ping for update messages
command-follow-settings-new_project_ping_role =
    .name = new_project_ping_role
    .description = Role to ping for new project messages, the update ping role if not set
command-follow-settings-reset_ping_roles =
    .name = reset_ping_roles
    .description = Remove both ping roles of this follow
